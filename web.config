<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Nonaktifkan directory listing -->
    <directoryBrowse enabled="false" />

    <!-- Dokumen default -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- URL Rewrite untuk meneruskan semua request ke index.php -->
    <rewrite>
      <rules>
        <!-- Izinkan file & folder yang sudah ada (assets, storage) -->
        <rule name="Allow Static Files" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Teruskan semua request ke index.php -->
        <rule name="Forward to index.php" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <!-- Sembunyikan header server -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

  </system.webServer>
</configuration>
