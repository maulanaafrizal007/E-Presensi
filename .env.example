APP_NAME="SIKAP DPD RI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Sesuaikan dengan cara akses Anda:
# - Via XAMPP/Laragon (htdocs): APP_URL=http://localhost/E-Presensi
# - Via php artisan serve / built-in server: APP_URL=http://localhost:8000
APP_URL=http://localhost/E-Presensi

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sikap_dpd
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="sikap@dpd.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# SSO Configuration (set to 'dev' for development mode)
SSO_MODE=dev
SSO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
