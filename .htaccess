Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Izinkan akses langsung ke file & folder yang ada (css, gambar, dll)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^$ - [L]

    # Semua request lain ke index.php di root
    RewriteRule ^ index.php [L]
</IfModule>
